{
  "manifest_version": 3,
  "name": "Glass Fox",
  "version": "0.1.1",
  "description": "Dark glass theme and workspace new tab for Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "glass-fox@kingjayan",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "theme",
    "topSites",
    "search"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
